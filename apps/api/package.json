{
  "name": "@repo-books/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "pnpm --filter @repo-books/shared build && tsx watch src/index.ts",
    "build": "pnpm --filter @repo-books/shared build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @repo-books/shared build && tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@lmstudio/sdk": "^1.5.0",
    "@repo-books/shared": "workspace:*",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
